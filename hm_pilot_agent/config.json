{
  "name": "HM Pilot Agent",
  "version": "1.0.1",
  "slug": "hm_pilot_agent",
  "description": "Lets your MSP look after this Home Assistant through HM Pilot.",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "image": "ghcr.io/iwaneo/hm-pilot-agent",
  "startup": "application",
  "boot": "auto",
  "hassio_api": true,
  "hassio_role": "homeassistant",
  "homeassistant_api": true,
  "ingress": true,
  "ingress_port": 8099,
  "panel_admin": true,
  "panel_icon": "mdi:shield-account",
  "backup": "hot",
  "backup_exclude": [
    "agent-private"
  ],
  "options": {
    "bundle": ""
  },
  "schema": {
    "bundle": "password?"
  }
}
